        </mxCell>
        <mxCell id="front" value="&lt;b&gt;🐳 Frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;static / SSR container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
