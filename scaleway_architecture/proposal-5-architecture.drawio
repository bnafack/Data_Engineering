        </mxCell>
        <mxCell id="fw" value="&lt;b&gt;🔥 Firewall (nftables/ufw) · 80/443 open · 22 admin IPs only · fail2ban&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7F1D1D;fontSize=12;" vertex="1" parent="1">
