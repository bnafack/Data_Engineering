        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;🔀 Reverse proxy (Traefik / Caddy) – only public entry point&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Let's Encrypt TLS · rate limiting · security headers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#9A3412;fontSize=13;" vertex="1" parent="1">
