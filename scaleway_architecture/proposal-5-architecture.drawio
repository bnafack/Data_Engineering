        <!-- VPS -->
        <mxCell id="vps" value="&lt;b&gt;🖥️ Dedibox VPS-START-2-XXL · public IPv4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;16 cores · 32 GB RAM · 320 GB SSD · 1 Gbps · €89.99/mo&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2.5;fontColor=#1E3A8A;fontSize=16;verticalAlign=top;spacingTop=4;shadow=1;" vertex="1" parent="1">
