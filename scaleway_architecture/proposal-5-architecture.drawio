        <mxCell id="admin" value="&lt;b&gt;👤 Admin / Ops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SSH key only (no password)&lt;br&gt;fixed admin IPs&lt;br&gt;DB via SSH tunnel&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;fontColor=#0F172A;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="415" width="150" height="80" as="geometry"/>
