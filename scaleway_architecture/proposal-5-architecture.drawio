        </mxCell>
        <mxCell id="backup" value="&lt;b&gt;💾 Backup job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pgBackRest / pg_dump → S3&lt;br&gt;nightly + WAL · restore tested&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="514" width="240" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="mon" value="&lt;b&gt;📊 Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Prometheus + Grafana / Netdata&lt;br&gt;or ship logs to Cockpit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
