        <mxCell id="workers" value="&lt;b&gt;⚙️ Workers / cron&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;background jobs, queues&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
