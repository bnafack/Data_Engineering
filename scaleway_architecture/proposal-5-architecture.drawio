        <mxCell id="pg" value="&lt;b&gt;🐘 PostgreSQL (self-hosted)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;volume on local SSD · not exposed&lt;br&gt;only reachable on Docker network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
