        <mxCell id="title" value="Proposal 5 – Single Dedibox VPS · self-hosted services · LWS DNS" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1">
