        <mxCell id="scw" value="☁️ Scaleway – Dedibox VPS + Cloud services (fr-par)" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;fillColor=#4F0599;swimlaneFillColor=#FAF5FF;strokeColor=#4F0599;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1">
