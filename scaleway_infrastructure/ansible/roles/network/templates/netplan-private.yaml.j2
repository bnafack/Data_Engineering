# Managed by Ansible (role network). UNVERIFIED on Elastic Metal.
# Only the Private Network VLAN is declared here. The public NIC configuration (installer file) is untouched.
network:
  version: 2
  vlans:
    {{ network_vlan_interface }}:
      id: {{ network_vlan_id | int }}
      link: {{ network_parent_interface_effective }}
{% if network_use_dhcp | bool %}
      dhcp4: true
      dhcp4-overrides:
        use-routes: {{ network_dhcp_use_routes | bool | lower }}
        use-dns: {{ network_dhcp_use_dns | bool | lower }}
{% else %}
      dhcp4: false
      addresses:
        - {{ network_static_address }}
{% endif %}
{% if network_mtu | string | length > 0 %}
      mtu: {{ network_mtu | int }}
{% endif %}
