---
# PROD variables. Copy to main.yml (git-ignored) and edit:
#   cp main.yml.example main.yml
# Values that come from Terraform (private CIDR, IPs, bastion) live in terraform.yml,
# generated by ./gen-inventory.sh prod. Do not duplicate them here.

env_name: prod   # must match the directory name; checked before every run
timezone: Europe/Paris

# SSH is allowed from these CIDRs (same idea as Terraform bastion_allowed_cidrs) AND from the Private Network.
admin_cidrs:
  - 203.0.113.10/32

# First-run escape hatch: also allow SSH from anywhere while the firewall is configured.
# Leave false unless your admin IP is not in admin_cidrs yet. Set back to false and re-run.
base_firewall_relaxed: false

# Private Network VLAN interface (netplan, file /etc/netplan/60-private-network.yaml, VLAN "vlan<id>").
# Verified on Elastic Metal Ubuntu (dev). Replaces a hand-made file at the same path.
network_configure: true
# Netplan ID of the parent NIC (key under `ethernets:` in /etc/netplan/50-cloud-init.yaml, e.g. eth0),
# NOT the kernel name (eno1). Empty = auto-detect by MAC.
network_parent_interface: ""

# Simple firewall (./run.sh prod firewall). Defaults: SSH only from the Private Network (= through the
# bastion), everything else denied. Uncomment to change.
# firewall_ssh_from:                  # who may use SSH
#   - 172.16.68.0/22              # the Private Network (bastion)
#   - 203.0.113.10/32                 # your own address, to also allow SSH on the public IP
# firewall_allow:                     # extra open ports (src defaults to the Private Network)
#   - { port: 80,   src: 172.16.68.0/22, comment: load balancer }
#   - { port: 443,  src: 172.16.68.0/22, comment: load balancer }
#   - { port: 8080, src: 203.0.113.10/32, comment: test from home }
# firewall_reset: false               # true = delete all existing rules first (also those added by k3s)

docker_enabled: true

# k3s (app server only). Exact version, never "latest". Upgrade by changing it.
k3s_version: "v1.37.2+k3s1"
k3s_fetch_kubeconfig: true

# Argo CD (off by default)
argocd_enabled: false
argocd_root_app_repo_url: ""
