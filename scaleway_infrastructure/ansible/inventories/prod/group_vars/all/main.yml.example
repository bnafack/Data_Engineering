---
# PROD variables. Copy to main.yml (git-ignored) and edit:
#   cp main.yml.example main.yml
# Values that come from Terraform (private CIDR, IPs, bastion) live in terraform.yml,
# generated by ./gen-inventory.sh prod. Do not duplicate them here.

env_name: prod   # must match the directory name; checked before every run
timezone: Europe/Paris

# SSH is allowed from these CIDRs (same idea as Terraform bastion_allowed_cidrs) AND from the Private Network.
admin_cidrs:
  - 203.0.113.10/32

# First-run escape hatch: also allow SSH from anywhere while the firewall is configured.
# Leave false unless your admin IP is not in admin_cidrs yet. Set back to false and re-run.
base_firewall_relaxed: false

# Private Network VLAN interface (netplan). Opt-in until verified on a real server.
network_configure: false

docker_enabled: true

# k3s (app server only). Exact version, never "latest". Upgrade by changing it.
k3s_version: "v1.37.2+k3s1"
k3s_fetch_kubeconfig: true

# Argo CD (off by default)
argocd_enabled: false
argocd_root_app_repo_url: ""
