# Copy to terraform.tfvars (git-ignored): cp terraform.tfvars.example terraform.tfvars
# Never put API keys here: use the SCW_ACCESS_KEY / SCW_SECRET_KEY /
# SCW_DEFAULT_ORGANIZATION_ID environment variables.
# Set project_id below instead of exporting SCW_DEFAULT_PROJECT_ID.
#
# Every variable of variables.tf is listed below.
# Values marked REQUIRED have no default and must be set.
# All other values show the default; change them as needed.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
project_id  = null # set your project ID here (null needs SCW_DEFAULT_PROJECT_ID and the "read project" permission)
region      = "fr-par"
zone        = "fr-par-1"
name_prefix = "proposal7"
tags        = ["proposal7", "terraform"]

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
private_network_cidr = "172.16.64.0/22"
# Public Gateway (SSH bastion), billed hourly (~23 EUR/month). false = no bastion.
create_public_gateway = true
gateway_type          = "VPC-GW-S"
bastion_port          = 61000

# REQUIRED: must not be empty. Use your admin public IPs, e.g. ["203.0.113.10/32"].
bastion_allowed_cidrs = ["203.0.113.10/32"]

# ---------------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------------
# REQUIRED: one or more OpenSSH public keys, as name = "public key".
# The name is the IAM SSH key name. Add one line per admin.
ssh_public_keys = {
  "alice-laptop" = "ssh-ed25519 AAAA... alice@host"
  "bob-laptop"   = "ssh-ed25519 AAAA... bob@host"
}

server_ssh_user = "ubuntu"

# ---------------------------------------------------------------------------
# Load balancer
# ---------------------------------------------------------------------------
# Load balancer, billed hourly (~20 EUR/month). false = no load balancer.
create_load_balancer = true
lb_type              = "LB-S"
app_http_port        = 80
app_https_port       = 443

# Optional Let's Encrypt certificate on the load balancer (TLS terminated on the LB).
# [] = no certificate, TCP pass-through (TLS on the app server).
# The names must already point to lb_public_ip (A record at LWS) before apply.
lb_domain_names           = []   # e.g. ["app.example.com", "www.example.com"]
lb_health_check_http_path = null # e.g. "/healthz" (null = TCP health check)

# ---------------------------------------------------------------------------
# Bare metal servers (billed as soon as created)
# ---------------------------------------------------------------------------
# Set to false to deploy everything else first and order the servers later.
create_app_server         = true
create_cartography_server = true

app_offer_name         = "EM-A410X-SSD"
cartography_offer_name = "EM-B420E-NVMe"

app_private_network_option_name         = "Private Networks 1 Gbps feature"
cartography_private_network_option_name = "Private Networks 10 Gbps feature"

# Recommended: the exact option IDs of your offers (they override the names).
# Find them with: ./find-pn-options.sh <zone> <offer-name> [hourly|monthly]
app_private_network_option_id         = null
cartography_private_network_option_id = null

# Alternative cartography server (cheaper, 256 GB RAM, SATA SSD):
# cartography_offer_name                  = "EM-B212X-SSD"
# cartography_private_network_option_name = "Private Networks 1 Gbps feature"

os_name                   = "Ubuntu"
os_version                = "26.04 LTS (Resolute Raccoon)"
offer_subscription_period = "monthly"

# Optional cloud-init (only if the offer supports it). null = none.
app_cloud_init         = null
cartography_cloud_init = null

# Protection against accidental deletion of the servers.
server_protected = false

# ---------------------------------------------------------------------------
# Managed PostgreSQL
# ---------------------------------------------------------------------------
db_engine                 = "PostgreSQL-16"
db_node_type              = "db-play2-pico"
db_volume_type            = "sbs_15k" # 15k IOPS (sbs_5k also allowed)
db_volume_size_gb         = 50
db_is_ha                  = false
db_backup_retention_days  = 7
db_backup_frequency_hours = 24
db_encryption_at_rest     = true
db_admin_user             = "rdb_admin"
db_name                   = "app"
db_app_user               = "app_user"

# ---------------------------------------------------------------------------
# Storage and registry
# ---------------------------------------------------------------------------
# REQUIRED: globally unique suffix (3-30 chars: lowercase letters, digits, hyphens).
bucket_suffix = "changeme-abc123"

# null = derived from name_prefix and bucket_suffix.
documents_bucket_name   = null
backups_bucket_name     = null
registry_namespace_name = null

# Allow terraform destroy to delete non-empty buckets (keep false in production).
buckets_force_destroy = false

# ---------------------------------------------------------------------------
# Secret Manager (database passwords, application API key)
# ---------------------------------------------------------------------------
secrets_enabled          = true
secrets_path             = null  # null = "/<name_prefix>", e.g. /dev
secrets_protected        = false # true = cannot be deleted until protection is removed
secrets_grant_app_access = true  # the application identity can read the project's secrets
