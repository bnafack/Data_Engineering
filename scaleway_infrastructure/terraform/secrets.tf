# Secrets generated by this stack, stored in Scaleway Secret Manager.
#
#   <path>/db-admin     PostgreSQL administrator  (key_value: username, password, host, port, dbname, sslmode)
#   <path>/db-app       PostgreSQL application user (same keys)
#   <path>/app-api-key  IAM API key of the application (key_value: access_key, secret_key, project_id)
#
# Read a secret:   scw secret version access-by-path secret-path=/<env> secret-name=db-app revision=latest
# The workload identity (IAM application "<prefix>-app") can read them when secrets_grant_app_access = true.
#
# NOTE: the values are also stored in the Terraform state (random_password, rdb and IAM resources already
# hold them). Keep the state in a private, encrypted backend.

locals {
  secrets_path = coalesce(var.secrets_path, "/${var.name_prefix}")

  db_connection = {
    host    = scaleway_rdb_instance.main.private_network[0].ip
    port    = tostring(scaleway_rdb_instance.main.private_network[0].port)
    dbname  = scaleway_rdb_database.app.name
    sslmode = "require"
  }

  secrets = var.secrets_enabled ? {
    db-admin = {
      description = "PostgreSQL administrator (${var.db_admin_user})"
      data = merge(local.db_connection, {
        username = var.db_admin_user
        password = random_password.db_admin.result
      })
    }
    db-app = {
      description = "PostgreSQL application user (${var.db_app_user})"
      data = merge(local.db_connection, {
        username = scaleway_rdb_user.app.name
        password = random_password.db_app.result
      })
    }
    app-api-key = {
      description = "IAM API key of the application ${scaleway_iam_application.app.name}"
      data = {
        access_key = scaleway_iam_api_key.app.access_key
        secret_key = scaleway_iam_api_key.app.secret_key
        project_id = local.project_id
      }
    }
  } : {}
}

resource "scaleway_secret" "main" {
  for_each = local.secrets

  name        = each.key
  path        = local.secrets_path
  description = each.value.description
  type        = "key_value"
  protected   = var.secrets_protected
  tags        = var.tags
}

# A new version is created whenever a value changes (e.g. a rotated password).
resource "scaleway_secret_version" "main" {
  for_each = local.secrets

  secret_id   = scaleway_secret.main[each.key].id
  description = "Managed by Terraform"
  data        = jsonencode(each.value.data)
}

# Let the workloads read the secrets with the application API key.
# IAM permission sets are project-scoped: this gives access to ALL secrets of the project,
# not only the ones above. Use a dedicated project per environment.
resource "scaleway_iam_policy" "secrets_read" {
  count = var.secrets_enabled && var.secrets_grant_app_access ? 1 : 0

  name           = "${var.name_prefix}-secrets-read"
  description    = "Read secrets from Secret Manager"
  application_id = scaleway_iam_application.app.id

  rule {
    project_ids          = [local.project_id]
    permission_set_names = ["SecretManagerReadOnly", "SecretManagerSecretAccess"]
  }
}
